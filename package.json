{
    "name": "@unikue/typedoc-plugin-raw-content",
    "version": "1.1.1",
    "title": "TypedocPluginRawContent",
    "description": "Generates extra raw html contents during typedoc compilation",
    "homepage": "https://unikueltd.github.io/typedoc-plugin-raw-content",
    "organization": "Unikue Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "typedoc",
        "typedoc-plugin",
        "typedoc-plugin-raw-content"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/lib/index.js",
    "types": "dist/lib/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "del-cli ./dist && tsc --outDir ./dist/lib",
        "docs:build": "typedoc --out ./docs-dist",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "upgrade": "npx npm-check-updates --target semver -u"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.4",
        "del-cli": "^7.0.0",
        "eslint": "^10.5.0",
        "gh-pages": "^6.3.0",
        "globals": "^17.7.0",
        "typedoc": "~0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    },
    "peerDependencies": {
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/unikueltd/typedoc-plugin-raw-content.git"
    },
    "bugs": {
        "url": "https://github.com/unikueltd/typedoc-plugin-raw-content/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/unikue-awesome"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/unikue-awesome"
        },
        {
            "type": "individual",
            "url": "https://unikue.cn/donation"
        }
    ],
    "author": {
        "name": "Unikue Ltd",
